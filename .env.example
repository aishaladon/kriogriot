ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Auth ───────────────────────────────────────────────────────
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# ── Data backend ──────────────────────────────────────────────
# mysql (default, current backend) or airtable (legacy)
DB_DRIVER=mysql

# MySQL (used when DB_DRIVER=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_database
MYSQL_POOL=5

# Airtable (legacy — only used when DB_DRIVER=airtable)
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# ── NAS mirroring (optional — see NAS-FTPS.md) ─────────────────
# Unset means uploads are simply not mirrored; nothing else breaks.
# NAS_HOST accepts a bare hostname or a full ftps://host:port URL.
NAS_HOST=ftps://your-nas.synology.me:277
NAS_USER=your_nas_ftp_user
NAS_PASS=your_nas_ftp_password
NAS_FOLDER=/

PORT=3000
